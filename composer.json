{
    "name": "semitexa/orm",
    "description": "Semitexa ORM \u2014 attribute-driven schema, connection pooling, MySQL adapter",
    "type": "semitexa-module",
    "license": "MIT",
    "authors": [
        {
            "name": "Semitexa",
            "email": "support@semitexa.com"
        }
    ],
    "require": {
        "php": "^8.4",
        "semitexa/core": "^2026.09.13.1330 || dev-master",
        "semitexa/tenancy": "^2026.09.13.1330 || dev-master"
    },
    "require-dev": {
        "phpunit/phpunit": "^12.5",
        "swoole/ide-helper": "^5.1"
    },
    "scripts": {
        "test": "phpunit --bootstrap vendor/autoload.php tests"
    },
    "config": {
        "allow-plugins": {
            "semitexa/core": true
        }
    },
    "autoload": {
        "psr-4": {
            "Semitexa\\Orm\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Semitexa\\Orm\\Tests\\": "tests/"
        }
    },
    "keywords": [
        "semitexa",
        "orm",
        "mysql",
        "schema",
        "attributes"
    ]
}
